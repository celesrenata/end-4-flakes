# Environment variables for dots-hyprland
# NOTE: HOME is available via the login shell / systemd user session.
# Upstream commit e8721b4b fixed os.getenv("HOME") for Lua configs;
# our .conf.template format uses $HOME which Hyprland expands natively.
# We intentionally do NOT set HOME here to avoid overriding the system value.

# ######### Input method ##########
# See https://fcitx-im.org/wiki/Using_Fcitx_5_on_Wayland
env = QT_IM_MODULE, fcitx
env = XMODIFIERS, @im=fcitx
env = SDL_IM_MODULE, fcitx
env = GLFW_IM_MODULE, ibus
env = INPUT_METHOD, fcitx

# ############ Wayland #############
env = ELECTRON_OZONE_PLATFORM_HINT, auto

# ############ Applications #############
# Append to XDG_DATA_DIRS rather than overriding (upstream fix for #2583/#3354)
env = XDG_DATA_DIRS, $HOME/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:/usr/local/share:/usr/share:$XDG_DATA_DIRS

# ############ Themes #############
env = QT_QPA_PLATFORM, wayland
env = QT_QPA_PLATFORMTHEME, @QT_THEME@
env = XDG_MENU_PREFIX, plasma-

# ######## Hardware specific #########
@NVIDIA_ENV@
@AMD_ENV@

# ######## Virtual environment #########
env = ILLOGICAL_IMPULSE_VIRTUAL_ENV, @DATA_DIR@/.venv

# ######## NixOS specific #########
env = NIXOS_OZONE_WL, 1
