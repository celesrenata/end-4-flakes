# ######## Window rules ########
# Hyprland 0.53+ syntax: windowrule = effect value, match:prop regex

# Global transparency (uncomment to apply to all windows)
@GLOBAL_TRANSPARENCY@

# Disable blur for xwayland context menus
windowrule = no_blur, match:class ^()$, match:title ^()$

# Floating windows
windowrule = float true, match:class ^(blueberry\.py)$
windowrule = float true, match:class ^(guifetch)$
windowrule = float true, match:class ^(pavucontrol)$
windowrule = size 45% 45%, match:class ^(pavucontrol)$
windowrule = center true, match:class ^(pavucontrol)$
windowrule = float true, match:class ^(org.pulseaudio.pavucontrol)$
windowrule = size 45% 45%, match:class ^(org.pulseaudio.pavucontrol)$
windowrule = center true, match:class ^(org.pulseaudio.pavucontrol)$
windowrule = float true, match:class ^(nm-connection-editor)$
windowrule = size 45% 45%, match:class ^(nm-connection-editor)$
windowrule = center true, match:class ^(nm-connection-editor)$
windowrule = float true, match:class .*plasmawindowed.*
windowrule = float true, match:class kcm_.*
windowrule = float true, match:class .*bluedevilwizard
windowrule = float true, match:title .*Welcome
windowrule = float true, match:title ^(illogical-impulse Settings)$
windowrule = float true, match:class org.freedesktop.impl.portal.desktop.kde
windowrule = float true, match:class ^(Zotero)$
windowrule = size 45% 45%, match:class ^(Zotero)$

# Special positioning
windowrule = float true, match:class ^(plasma-changeicons)$
windowrule = no_initial_focus true, match:class ^(plasma-changeicons)$
windowrule = move 999999 999999, match:class ^(plasma-changeicons)$
windowrule = move 40 80, match:title ^(Copying — Dolphin)$

# Force tiling for specific apps
windowrule = tile true, match:class ^dev\.warp\.Warp$

# Picture-in-Picture
windowrule = float true, match:title ^([Pp]icture[-\s]?[Ii]n[-\s]?[Pp]icture)(.*)$
windowrule = keep_aspect_ratio true, match:title ^([Pp]icture[-\s]?[Ii]n[-\s]?[Pp]icture)(.*)$
windowrule = move 73% 72%, match:title ^([Pp]icture[-\s]?[Ii]n[-\s]?[Pp]icture)(.*)$
windowrule = size 25% 25%, match:title ^([Pp]icture[-\s]?[Ii]n[-\s]?[Pp]icture)(.*)$
windowrule = pin true, match:title ^([Pp]icture[-\s]?[Ii]n[-\s]?[Pp]icture)(.*)$

# Dialog windows – float+center these windows
windowrule = float true, match:title ^(Open File)(.*)$
windowrule = center true, match:title ^(Open File)(.*)$
windowrule = float true, match:title ^(Select a File)(.*)$
windowrule = center true, match:title ^(Select a File)(.*)$
windowrule = float true, match:title ^(Choose wallpaper)(.*)$
windowrule = center true, match:title ^(Choose wallpaper)(.*)$
windowrule = float true, match:title ^(Open Folder)(.*)$
windowrule = center true, match:title ^(Open Folder)(.*)$
windowrule = float true, match:title ^(Save As)(.*)$
windowrule = center true, match:title ^(Save As)(.*)$
windowrule = float true, match:title ^(Library)(.*)$
windowrule = center true, match:title ^(Library)(.*)$
windowrule = float true, match:title ^(File Upload)(.*)$
windowrule = center true, match:title ^(File Upload)(.*)$
windowrule = float true, match:title ^(.*)(wants to save)$
windowrule = center true, match:title ^(.*)(wants to save)$
windowrule = float true, match:title ^(.*)(wants to open)$
windowrule = center true, match:title ^(.*)(wants to open)$

# --- Tearing for gaming ---
windowrule = immediate true, match:title .*\.exe
windowrule = immediate true, match:title .*minecraft.*
windowrule = immediate true, match:class ^(steam_app).*

# No shadow for tiled windows
windowrule = no_shadow true, match:float false

# ######## Workspace rules ########
workspace = special:special, gapsout:30

# ######## Layer rules ########
layerrule = xray 1, .*

# No animations for specific layers
layerrule = noanim, walker
layerrule = noanim, selection
layerrule = noanim, overview
layerrule = noanim, anyrun
layerrule = noanim, indicator.*
layerrule = noanim, osk
layerrule = noanim, hyprpicker
layerrule = noanim, noanim

# GTK layer shell
layerrule = blur, gtk-layer-shell
layerrule = ignorealpha 0, gtk-layer-shell

# Launcher
layerrule = blur, launcher
layerrule = ignorealpha 0.5, launcher

# Notifications
layerrule = blur, notifications
layerrule = ignorealpha 0.69, notifications

# Logout dialog
layerrule = blur, logout_dialog

# AGS layers
layerrule = animation slide left, sideleft.*
layerrule = animation slide right, sideright.*
layerrule = blur, session[0-9]*
layerrule = blur, bar[0-9]*
layerrule = ignorealpha 0.6, bar[0-9]*
layerrule = blur, barcorner.*
layerrule = ignorealpha 0.6, barcorner.*
layerrule = blur, dock[0-9]*
layerrule = ignorealpha 0.6, dock[0-9]*
layerrule = blur, indicator.*
layerrule = ignorealpha 0.6, indicator.*
layerrule = blur, overview[0-9]*
layerrule = ignorealpha 0.6, overview[0-9]*
layerrule = blur, cheatsheet[0-9]*
layerrule = ignorealpha 0.6, cheatsheet[0-9]*
layerrule = blur, sideright[0-9]*
layerrule = ignorealpha 0.6, sideright[0-9]*
layerrule = blur, sideleft[0-9]*
layerrule = ignorealpha 0.6, sideleft[0-9]*
layerrule = blur, osk[0-9]*
layerrule = ignorealpha 0.6, osk[0-9]*

# Quickshell layers
layerrule = blurpopups, quickshell:.*
layerrule = blur, quickshell:.*
layerrule = ignorealpha 0.79, quickshell:.*
layerrule = animation slide top, quickshell:bar
layerrule = animation fade, quickshell:screenCorners
layerrule = animation slide right, quickshell:sidebarRight
layerrule = animation slide left, quickshell:sidebarLeft
layerrule = noanim, quickshell:overview
layerrule = animation slide bottom, quickshell:osk
layerrule = animation slide bottom, quickshell:dock
layerrule = blur, quickshell:session
layerrule = noanim, quickshell:session
layerrule = ignorealpha 0, quickshell:session
layerrule = animation fade, quickshell:notificationPopup
layerrule = blur, quickshell:backgroundWidgets
layerrule = ignorealpha 0.05, quickshell:backgroundWidgets
layerrule = noanim, quickshell:screenshot
layerrule = animation popin 120%, quickshell:screenCorners
layerrule = noanim, quickshell:lockWindowPusher

# Launchers
layerrule = noanim, gtk4-layer-shell

# Outfoxxed's shell layers
layerrule = blur, shell:bar
layerrule = ignorealpha 0, shell:bar
layerrule = blur, shell:notifications
layerrule = ignorealpha 0.1, shell:notifications

# Custom window rules
@CUSTOM_WINDOW_RULES@
